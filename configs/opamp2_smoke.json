{
  "model": {
    "dim": 32,
    "heads": 4,
    "encoder_layers": 2,
    "cross_layers": 1,
    "ffn_dim": 64,
    "decoder_layers": 1,
    "decoder_ffn_dim": 64,
    "dropout": 0.1,
    "max_devices": 128,
    "terminal_bias": true
  },
  "loss": {
    "invariance": 25.0,
    "variance": 25.0,
    "covariance": 1.0,
    "variance_floor": 1.0
  },
  "training": {
    "seed": 17,
    "batch_size": 16,
    "pretrain_epochs": 1,
    "decoder_epochs": 1,
    "baseline_epochs": 2,
    "pretrain_lr": 0.001,
    "decoder_lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "torch_threads": 1,
    "progress_every": 100
  },
  "dataset": {
    "train_circuits": [
      "Opamp2"
    ],
    "ood_circuits": [],
    "split_ratios": [
      0.8,
      0.1,
      0.1
    ],
    "split_seed": 17,
    "finetune_label_fraction": 1.0
  },
  "normalization": {
    "weighting": "equal_circuit",
    "op_fields": null,
    "parameters": {},
    "op": {},
    "performance": {}
  },
  "op_state": {
    "mode": "collector_checked",
    "features": [
      "current_missing",
      "current_below",
      "current_pass",
      "saturation_missing",
      "saturation_below",
      "saturation_pass"
    ]
  },
  "baseline": {
    "pin_terminal_bias": false
  }
}
