{
  "model": {
    "dim": 128,
    "heads": 8,
    "encoder_layers": 6,
    "cross_layers": 4,
    "ffn_dim": 512,
    "decoder_layers": 2,
    "decoder_ffn_dim": 2048,
    "dropout": 0.1,
    "max_devices": 200,
    "terminal_bias": true
  },
  "loss": {
