{
  "model": {
    "dim": 128,
    "heads": 8,
    "encoder_layers": 6,
    "cross_layers": 4,
    "ffn_dim": 512,
    "decoder_layers": 2,
    "decoder_ffn_dim": 2048,
    "dropout": 0.1,
    "max_devices": 200,
    "terminal_bias": true
  },
  "loss": {
    "invariance": 25.0,
    "variance": 25.0,
    "covariance": 1.0,
    "variance_floor": 1.0
  },
  "training": {
    "seed": 17,
    "batch_size": 32,
    "pretrain_epochs": 30,
    "decoder_epochs": 50,
    "baseline_epochs": 80,
    "pretrain_lr": 0.0001,
    "decoder_lr": 0.0001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "torch_threads": 1,
    "progress_every": 100,
    "early_stopping": {
      "enabled": true,
      "patience": 10,
      "min_delta": 0.0,
      "min_epochs": 1
    }
  },
  "dataset": {
    "train_circuits": [
      "synthetic_0",
      "synthetic_1",
      "synthetic_2",
      "synthetic_3"
    ],
    "ood_circuits": [
      "synthetic_4"
    ],
    "split_ratios": [
      0.8,
      0.1,
      0.1
    ],
    "split_seed": 17,
    "finetune_label_fraction": 1.0
  },
  "normalization": {
    "weighting": "equal_circuit",
    "op_fields": null,
    "parameters": {},
    "op": {},
    "performance": {}
  },
  "op_state": {
    "mode": "collector_checked",
    "features": [
      "current_missing",
      "current_below",
      "current_pass",
      "saturation_missing",
      "saturation_below",
      "saturation_pass"
    ]
  },
  "baseline": {
    "pin_terminal_bias": false
  }
}
