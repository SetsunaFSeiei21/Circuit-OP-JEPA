    "covariance": 1.0,
    "variance_floor": 1.0
  },
  "training": {
    "seed": 17,
    "batch_size": 32,
    "pretrain_epochs": 30,
    "decoder_epochs": 50,
    "pretrain_lr": 0.0001,
    "decoder_lr": 0.0001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "torch_threads": 1
  }
}
