# Observed reference cluster settings, not guessed.
# Source: Analog-Agent-NN-Memory/analog-agent/scripts/run/submit_sampling.sh
# Usage: source scripts/run/cluster.env.example (then override data/config/output CLI).
# Safe: still preview only until explicitly setting DRY_RUN=0.
# Choose models in the submission command (CLI overrides config experiment.models):
# MODELS=(jepa_zerosim zerosim_device)
# DRY_RUN=0 bash scripts/run/submit_raw_comparison.sh --input ... --models "${MODELS[@]}" --device cuda
# List names without submitting: bash scripts/run/submit_raw_comparison.sh --list-models
export DRY_RUN=1
export SLURM_ACCOUNT=b_phzhwu
export SLURM_PARTITION=ex01A800
export SLURM_CPUS=8
export SLURM_GPUS=1
export SLURM_MEM=80G
export SLURM_TIME=10-00:00:00
export JEPA_CONDA_ENV=newbase
export JEPA_CONDA_HOME=/share/software/anaconda3
# Raw runs without --output use the primary checkout's runs/gpu_full/<circuit>_<date>/.
# Optional absolute override for that results base directory:
# export JEPA_RESULTS_ROOT=/path/to/original/Circuit-OP-JEPA/runs/gpu_full
# Optional absolute directory shared by logs from different worktrees.
# export JEPA_LOG_DIR=/path/to/original/Circuit-OP-JEPA/hpc_logs/gpu_full
# Reference scripts use mail-type BEGIN,END,FAIL. Set your own recipient explicitly.
export SLURM_MAIL_TYPE=BEGIN,END,FAIL
# export SLURM_MAIL_USER=your-address@example.com
# No QoS setting appeared in the reference scripts.
